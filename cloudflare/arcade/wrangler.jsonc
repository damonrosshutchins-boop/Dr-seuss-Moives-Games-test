{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "seuss-arcade-relay",
  "main": "worker.mjs",
  "compatibility_date": "2025-03-10",
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [{ "name": "WISP_RELAY", "class_name": "WispRelay" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["WispRelay"] },
    { "tag": "v2", "new_sqlite_classes": ["BotBoard"] },
    { "tag": "v3", "deleted_classes": ["BotBoard"] }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://damonrosshutchins-boop.github.io,http://localhost:8080,http://127.0.0.1:8080",
    "ALLOW_PRIVATE_IPS": "0",
    "ALLOW_DIRECT_IP": "1"
  }
}
